{
  "name": "@teknixglobal/medusa-vietnam",
  "version": "0.1.0",
  "description": "Vietnamese payment providers for Medusa v2: SePay, COD, VNPay. Works with plain Medusa and Mercur.",
  "author": "Teknix (https://github.com/teknixglobal)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teknixglobal/medusa-vietnam.git"
  },
  "files": [
    ".medusa/server",
    "README.md",
    "CONTRACT.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa",
    "medusa-plugin",
    "medusa-plugin-payment",
    "medusa-v2",
    "vietnam",
    "sepay",
    "vnpay",
    "vietqr",
    "cod"
  ],
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "publish:local": "medusa plugin:publish",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "prepublishOnly": "medusa plugin:build"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.22.3",
    "@medusajs/admin-shared": "2.22.3",
    "@medusajs/cli": "2.22.3",
    "@medusajs/framework": "2.22.3",
    "@medusajs/icons": "2.22.3",
    "@medusajs/medusa": "2.22.3",
    "@medusajs/test-utils": "2.22.3",
    "@medusajs/ui": "4.2.9",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.7",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/framework": "~2.22.3",
    "@medusajs/medusa": "~2.22.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@medusajs/telemetry",
      "@swc/core",
      "esbuild"
    ]
  }
}

{
  "name": "teknix-vietnam-commerce-plugins",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "test": "jest --runInBand",
    "publish:local": "pnpm -r --workspace-concurrency=1 publish:local",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && node scripts/publish.mjs",
    "release:dry": "pnpm build && node scripts/publish.mjs --dry-run"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@medusajs/admin-sdk": "2.22.3",
    "@medusajs/admin-shared": "2.22.3",
    "@medusajs/cli": "2.22.3",
    "@medusajs/framework": "2.22.3",
    "@medusajs/icons": "2.22.3",
    "@medusajs/medusa": "2.22.3",
    "@medusajs/test-utils": "2.22.3",
    "@medusajs/ui": "4.2.9",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.7",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@medusajs/telemetry",
      "@swc/core",
      "esbuild"
    ]
  }
